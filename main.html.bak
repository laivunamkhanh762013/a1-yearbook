<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>A1 ( 2024 - 2028 )</title>
<link rel="icon" href="Logolop.jpeg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&family=Baloo+2:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="gallery.css">
<style>
:root {
  --gold:#FFD700; --orange:#FF6B00; --cyan:#00e5ff; --green:#4ade80;
  --bg:#0d0d14; --card:rgba(255,255,255,0.06); --border:rgba(255,255,255,0.12);
  --text:#f0f0f0; --muted:#9ca3af;
}
@keyframes rainbowMove { 0%{background-position:0% 50%} 100%{background-position:400% 50%} }
@keyframes fadeDown { from{opacity:0;transform:translateY(-36px)} to{opacity:1;transform:translateY(0)} }
@keyframes fadeUp   { from{opacity:0;transform:translateY(36px)}  to{opacity:1;transform:translateY(0)} }
@keyframes fadeIn   { from{opacity:0} to{opacity:1} }
@keyframes zoomIn   { from{opacity:0;transform:scale(0.82)} to{opacity:1;transform:scale(1)} }
@keyframes float    { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
@keyframes popIn    { 0%{transform:scale(0) rotate(-12deg);opacity:0} 65%{transform:scale(1.14) rotate(3deg);opacity:1} 100%{transform:scale(1) rotate(0);opacity:1} }
@keyframes emojiPop { 0%{transform:translate(-50%,-50%) scale(0) rotate(-20deg);opacity:0} 60%{transform:translate(-50%,-50%) scale(1.35) rotate(5deg);opacity:1} 100%{transform:translate(-50%,-50%) scale(1) rotate(0);opacity:1} }
@keyframes cardReveal { 0%{opacity:0;transform:scale(0.6) rotateY(90deg)} 60%{transform:scale(1.06) rotateY(-4deg)} 100%{opacity:1;transform:scale(1) rotateY(0)} }
@keyframes shake { 0%,100%{transform:translateX(0) rotate(0)} 20%{transform:translateX(-7px) rotate(-2deg)} 40%{transform:translateX(7px) rotate(2deg)} 60%{transform:translateX(-4px) rotate(-1deg)} 80%{transform:translateX(4px) rotate(1deg)} }
@keyframes slideLeft { from{opacity:0;transform:translateX(-60px)} to{opacity:1;transform:translateX(0)} }
@keyframes pulseGoldGlow { 0%,100%{box-shadow:0 0 10px rgba(255,215,0,0.3)} 50%{box-shadow:0 0 28px rgba(255,215,0,0.7)} }
@keyframes modalSlideUp { from{opacity:0;transform:translateY(50px) scale(0.94)} to{opacity:1;transform:translateY(0) scale(1)} }
@keyframes leaderIn { from{opacity:0;transform:translateX(-30px) scale(0.95)} to{opacity:1;transform:translateX(0) scale(1)} }
@keyframes ripple { 0%{transform:scale(0);opacity:0.6} 100%{transform:scale(4);opacity:0} }
@keyframes dots { 0%,20%{content:''} 40%{content:'.'} 60%{content:'..'} 80%,100%{content:'...'} }

* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }
body { font-family:'Quicksand',sans-serif; background:var(--bg); color:var(--text); min-height:100vh; overflow-x:hidden; }
body::before { content:""; position:fixed; inset:0; background:url('Lop.jpg') center/cover no-repeat; filter:blur(10px) brightness(0.28) saturate(0.5); z-index:-2; }
body::after  { content:""; position:fixed; inset:0; background:radial-gradient(ellipse at 15% 15%,rgba(0,100,255,0.18) 0%,transparent 55%),radial-gradient(ellipse at 85% 85%,rgba(180,30,100,0.12) 0%,transparent 55%); z-index:-1; pointer-events:none; }

/* LOADING */
#loadingScreen { position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;justify-content:center;align-items:center;z-index:99999;transition:opacity 0.9s ease; }
.load-title { font-family:'Baloo 2',cursive;font-size:40px;font-weight:800;background:linear-gradient(90deg,#ff6b6b,#ffd700,#4ade80,#00e5ff,#a78bfa,#ff6b6b);background-size:300%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:rainbowMove 2s linear infinite;margin-bottom:32px; }
.load-bar-wrap { width:340px;height:6px;background:rgba(255,255,255,0.08);border-radius:99px;overflow:hidden; }
.load-bar { height:100%;width:0%;background:linear-gradient(90deg,#00e5ff,#a78bfa,#ff6b6b);background-size:300%;animation:rainbowMove 2s linear infinite;transition:width 0.3s ease;border-radius:99px; }
.load-sub { color:var(--muted);font-size:13px;margin-top:16px;letter-spacing:1.5px;animation:fadeIn 1s ease 0.3s both; }
.load-sub::after { content:'';animation:dots 1.5s steps(4,end) infinite; }

/* NAVBAR */
.navbar { position:fixed;top:0;left:0;width:100%;display:flex;align-items:center;padding:11px 24px;gap:16px;background:rgba(8,8,18,0.8);backdrop-filter:blur(20px);border-bottom:1px solid rgba(0,229,255,0.12);z-index:1000;animation:fadeDown 0.8s cubic-bezier(0.34,1.56,0.64,1) both; }
.navbar-logo { display:flex;align-items:center;gap:10px; }
.navbar-logo img { height:38px;border-radius:8px;transition:transform 0.3s,box-shadow 0.3s; }
.navbar-logo img:hover { transform:rotate(8deg) scale(1.1);box-shadow:0 0 16px rgba(0,229,255,0.5); }
.navbar-title { font-family:'Baloo 2',cursive;font-weight:700;font-size:17px;color:white;white-space:nowrap; }
.navbar-center { flex:1;text-align:center;display:flex;align-items:center;justify-content:center;gap:14px; }
.navbar-made { font-size:13px;color:var(--muted); }
.navbar-creator { font-family:'Baloo 2',cursive;font-size:26px;font-weight:800;background:linear-gradient(90deg,var(--gold),var(--cyan),var(--gold));background-size:200%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:rainbowMove 4s linear infinite; }
.navbar-avatar { width:62px;height:62px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,0.25);box-shadow:0 0 14px rgba(0,229,255,0.35);flex-shrink:0;transition:transform 0.3s,box-shadow 0.3s;animation:float 3s ease-in-out infinite; }
.navbar-avatar:hover { transform:scale(1.14) rotate(-4deg);box-shadow:0 0 30px rgba(0,229,255,0.7); }
.navbar-menu { display:flex;gap:4px; }
.navbar-menu a { padding:7px 15px;border-radius:20px;text-decoration:none;color:white;font-weight:600;font-size:15px;white-space:nowrap;transition:all 0.25s;position:relative;overflow:hidden; }
.navbar-menu a::after { content:'';position:absolute;bottom:4px;left:50%;right:50%;height:2px;background:var(--cyan);transition:left 0.25s,right 0.25s;border-radius:2px; }
.navbar-menu a:hover::after { left:14px;right:14px; }
.navbar-menu a:hover { color:var(--cyan); }

/* SECTIONS */
section { padding-top:100px;min-height:100vh;text-align:center;scroll-margin-top:80px; }
.section-title { font-family:'Baloo 2',cursive;font-size:30px;font-weight:800;margin-bottom:20px;background:linear-gradient(90deg,white,var(--cyan),white);background-size:200%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:fadeDown 0.7s ease both,rainbowMove 6s linear 1s infinite; }

/* CLASS PHOTO */
.class-photo-wrap { display:inline-block;position:relative;animation:zoomIn 1s cubic-bezier(0.34,1.56,0.64,1) 0.3s both; }
.class-photo-wrap img { max-width:68%;border-radius:16px;border:2px solid rgba(0,229,255,0.2);box-shadow:0 12px 50px rgba(0,0,0,0.55);display:block;margin:0 auto;transition:transform 0.4s,box-shadow 0.4s;cursor:zoom-in; }
.class-photo-wrap:hover img { transform:scale(1.015);box-shadow:0 16px 60px rgba(0,229,255,0.15); }
.class-photo-overlay { position:absolute;inset:0;margin:auto;width:68%;border-radius:16px;background:rgba(0,0,0,0.52);display:flex;justify-content:center;align-items:center;opacity:0;transition:opacity 0.4s; }
.class-photo-wrap:hover .class-photo-overlay { opacity:1; }
.overlay-btn { padding:12px 26px;border:none;border-radius:30px;background:linear-gradient(135deg,var(--cyan),var(--green));color:#0d0d14;font-weight:700;font-size:14px;cursor:pointer;transition:transform 0.2s,box-shadow 0.2s;box-shadow:0 4px 22px rgba(0,229,255,0.4);animation:float 2s ease-in-out infinite; }
.overlay-btn:hover { transform:scale(1.09);box-shadow:0 6px 30px rgba(0,229,255,0.6); }

/* COUNTDOWN BOX (merged) */
.countdown-box {
  margin:28px auto; width:88%; max-width:620px;
  background:linear-gradient(135deg,rgba(20,20,40,0.7),rgba(10,10,25,0.9));
  backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:24px; padding:0; overflow:hidden;
  box-shadow:0 8px 40px rgba(0,0,0,0.3);
  transition:transform 0.3s,box-shadow 0.3s;
}
.countdown-box:hover {
  transform:translateY(-5px);
  box-shadow:0 16px 50px rgba(0,0,0,0.45);
}

.cd-section {
  padding:28px 28px 24px;
  transition:background 0.3s;
}
.cd-summer { background:linear-gradient(135deg,rgba(255,165,0,0.06),rgba(255,60,0,0.03)); }
.cd-school { background:linear-gradient(135deg,rgba(0,150,255,0.06),rgba(100,50,255,0.03)); }

.cd-section:hover {
  background:linear-gradient(135deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01));
}

.cd-top {
  display:flex; flex-direction:column; align-items:center;
  margin-bottom:4px;
}
.cd-count {
  font-family:'Baloo 2',cursive; font-size:68px; font-weight:800;
  color:var(--orange); text-shadow:0 0 40px rgba(255,107,0,0.5);
  animation:float 2.5s ease-in-out infinite; display:inline-block;
  line-height:1;
}
.cd-count-blue {
  color:var(--cyan); text-shadow:0 0 40px rgba(0,229,255,0.5);
}
.cd-sub {
  font-size:15px; color:var(--muted); margin-top:2px;
  font-weight:600; letter-spacing:0.5px;
}
.cd-sub-blue { color:#7fc8ff; }
.cd-label {
  font-family:'Baloo 2',cursive; font-size:16px; font-weight:700;
  color:var(--gold); margin-bottom:10px; letter-spacing:1px;
}
.cd-label-blue { color:var(--cyan); }

.cd-divider {
  display:flex; align-items:center; justify-content:center;
  height:2px; position:relative;
  background:linear-gradient(90deg,transparent,rgba(255,165,0,0.15),rgba(0,150,255,0.15),transparent);
}
.cd-divider span {
  position:absolute; font-size:12px; color:var(--muted);
  background:var(--bg); padding:0 16px;
  border-radius:20px; line-height:28px;
  border:1px solid rgba(255,255,255,0.06);
}

.prog-fill.summer-fill { background:linear-gradient(90deg,var(--orange),var(--gold),var(--orange)); background-size:300%; animation:rainbowMove 3s linear infinite; }
.prog-fill.school-fill { background:linear-gradient(90deg,var(--cyan),#6366f1,var(--cyan)); background-size:300%; animation:rainbowMove 3s linear infinite; box-shadow:0 0 12px rgba(0,229,255,0.3); }

.prog-pct-blue { color:var(--cyan) !important; }

.prog-row { display:flex;align-items:center;gap:10px;justify-content:center;margin-top:16px; }
.prog-label { font-size:12px;color:var(--muted); }
.prog-track { flex:1;max-width:240px;height:10px;background:rgba(255,255,255,0.07);border-radius:99px;overflow:hidden; }
.prog-fill { height:100%;border-radius:99px;background:linear-gradient(90deg,var(--orange),var(--gold),var(--orange));background-size:300%;animation:rainbowMove 3s linear infinite;transition:width 0.8s cubic-bezier(0.22,1,0.36,1); }
.prog-pct { font-size:13px;color:var(--gold);margin-top:6px;font-weight:600; }

/* RANDOM */
.random-box { margin:28px auto;width:88%;max-width:300px;background:var(--card);backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:22px;padding:20px;transition:transform 0.3s,box-shadow 0.3s; }
.random-box:hover { transform:translateY(-5px);box-shadow:0 12px 40px rgba(0,229,255,0.12); }
.random-box h3 { font-family:'Baloo 2',cursive;color:var(--gold);font-size:17px;margin-bottom:14px; }
.rand-card { cursor:pointer;border-radius:14px;overflow:hidden;background:rgba(255,255,255,0.04);border:1px solid var(--border);margin-bottom:14px;transition:transform 0.25s,box-shadow 0.25s; }
.rand-card:hover { transform:scale(1.03);box-shadow:0 0 24px rgba(0,229,255,0.25); }
.rand-card img { width:100%;display:block;max-height:280px;object-fit:cover;transition:filter 0.3s; }
.rand-card:hover img { filter:brightness(1.1); }
.rand-info { padding:12px 10px 10px; }
.rand-emoji { font-size:28px;margin-bottom:4px;animation:float 2s ease-in-out infinite;display:inline-block; }
.rand-name { font-weight:700;font-size:15px;color:white;display:block;margin-bottom:3px; }
.rand-detail { font-size:12px;color:var(--muted);display:block;line-height:1.7; }
.rand-card.spinning { animation:shake 0.35s ease infinite;filter:blur(2px) brightness(0.55);pointer-events:none; }
.rand-card.reveal { animation:cardReveal 0.5s cubic-bezier(0.34,1.56,0.64,1) both;filter:none; }
.btn-rainbow { padding:11px 26px;border:none;border-radius:30px;cursor:pointer;font-weight:700;font-size:14px;color:#0d0d14;background:linear-gradient(90deg,var(--gold),var(--orange),var(--gold));background-size:300%;animation:rainbowMove 2s linear infinite;transition:transform 0.2s,box-shadow 0.2s;box-shadow:0 4px 18px rgba(255,165,0,0.35);position:relative;overflow:hidden; }
.btn-rainbow:hover:not(:disabled) { transform:scale(1.08);box-shadow:0 6px 26px rgba(255,165,0,0.55); }
.btn-rainbow:disabled { opacity:0.45;cursor:not-allowed; }
#spinStatus { font-size:12px;color:var(--gold);margin-top:8px;min-height:16px;font-weight:600; }

/* LEADERBOARD */
.leader-box { margin:28px auto;width:88%;max-width:560px;background:var(--card);backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:22px;padding:26px;transition:transform 0.3s; }
.leader-box:hover { transform:translateY(-4px); }
.leader-box h2 { font-family:'Baloo 2',cursive;color:var(--gold);font-size:20px;margin-bottom:20px; }
.leader-row { display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:12px;margin-bottom:10px;background:rgba(255,255,255,0.04);border:1px solid var(--border);transition:transform 0.25s,box-shadow 0.25s;animation:leaderIn 0.6s ease both; }
.leader-row:hover { transform:translateX(7px);box-shadow:0 4px 22px rgba(0,229,255,0.12); }
.leader-medal { font-size:24px;width:36px;text-align:center;flex-shrink:0;animation:float 2.5s ease-in-out infinite;display:inline-block; }
.leader-name { font-weight:700;flex:1;text-align:left; }
.leader-name.gold   { color:var(--gold); }
.leader-name.silver { color:#d0d0d0; }
.leader-name.bronze { color:#cd7f32; }
.leader-rest { color:var(--muted);font-size:14px;line-height:2.2;margin-top:4px; }

/* MEMBERS */
#members { padding-top:100px; }
.search-wrap { display:flex;justify-content:center;margin:16px 0 20px; }
#searchInput { width:90%;max-width:480px;padding:14px 22px;border-radius:30px;border:1px solid var(--border);outline:none;background:rgba(255,255,255,0.06);color:white;font-size:15px;font-family:'Quicksand',sans-serif;backdrop-filter:blur(10px);transition:border-color 0.3s,box-shadow 0.3s,transform 0.2s; }
#searchInput::placeholder { color:rgba(255,255,255,0.38); }
#searchInput:focus { border-color:var(--cyan);transform:scale(1.01);box-shadow:0 0 22px rgba(0,229,255,0.2); }
#noResult { color:#ff6b6b;font-weight:700;margin:10px;animation:fadeUp 0.4s ease both; }
.rainbow-banner { margin:0 auto 18px;width:88%;max-width:560px;padding:13px;border-radius:14px;font-weight:700;font-size:14px;color:#0d0d14;background:linear-gradient(270deg,#ff6b6b,#ffd700,#4ade80,#00e5ff,#a78bfa,#ff6b6b);background-size:300%;animation:rainbowMove 4s linear infinite;box-shadow:0 4px 20px rgba(0,0,0,0.3);transition:transform 0.2s; }
.members-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:14px;padding:14px; }
.member-card { background:var(--card);backdrop-filter:blur(8px);border:1px solid var(--border);border-radius:14px;padding:10px;cursor:pointer;position:relative;transition:transform 0.3s cubic-bezier(0.34,1.56,0.64,1),box-shadow 0.3s,opacity 0.3s ease,margin 0.3s ease,padding 0.3s ease;animation:fadeUp 0.5s ease both;overflow:hidden; }
.member-card::before { content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,229,255,0.07),rgba(160,60,255,0.04));opacity:0;transition:opacity 0.3s; }
.member-card:hover::before { opacity:1; }
.member-card:hover { transform:translateY(-8px) scale(1.04);box-shadow:0 12px 36px rgba(0,229,255,0.22);border-color:rgba(0,229,255,0.32); }
.member-card img { width:100%;border-radius:10px;display:block;transition:transform 0.3s; }
.member-card:hover img { transform:scale(1.05); }
.member-card .mc-name { font-weight:700;font-size:13px;margin-top:7px; }
.member-card .mc-dob  { font-size:11px;color:var(--muted); }
.member-card .mc-nick { font-size:11px;color:var(--cyan);margin-top:2px; }
.highlight {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  padding: 0 4px;
  border-radius: 6px;
  box-shadow: 0 0 8px rgba(255, 255, 255, 0.08);
  font-weight: 700;
}

.member-card.search-hidden {
  opacity: 0;
  transform: scale(0.95) translateY(-8px);
  pointer-events: none;
  margin: 0;
  padding: 0;
  border: none;
  overflow: hidden;
}
.member-card.search-visible {
  animation: searchFadeIn 0.35s ease both;
}

@keyframes searchFadeIn {
  from {
    opacity: 0;
    transform: scale(0.92) translateY(12px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.search-wrap {
  transition: all 0.3s ease;
}
.search-wrap.sticky {
  position: sticky;
  top: 70px;
  z-index: 100;
  padding: 12px 0;
  background: rgba(13, 13, 20, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

mark { background:rgba(255,215,0,0.3);border-radius:3px;padding:0 2px;color:var(--gold); }
.rank-badge { position:absolute;top:8px;left:8px;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2);z-index:5;box-shadow:0 4px 15px rgba(0,0,0,0.3);animation:popIn 0.5s cubic-bezier(0.34,1.56,0.64,1) both; }
.rank-gold   { background:linear-gradient(135deg,#FFD700,#FFB800);color:#111;animation:popIn 0.5s ease both,pulseGoldGlow 2s ease-in-out infinite; }
.rank-silver { background:linear-gradient(135deg,#E5E7EB,#BFC5CE);color:#111; }
.rank-bronze { background:linear-gradient(135deg,#CD7F32,#A85A1F);color:white; }

/* TIMELINE */
#timeline { padding-top:100px; }
.timeline { max-width:580px;margin:20px auto;text-align:left;padding:0 16px; }
.tl-item { background:var(--card);backdrop-filter:blur(6px);border:1px solid var(--border);border-left:3px solid var(--gold);margin-bottom:12px;padding:15px 18px;border-radius:0 14px 14px 0;font-size:14px;transition:border-left-color 0.3s,transform 0.25s,box-shadow 0.25s;position:relative; }
.tl-item:hover { transform:translateX(7px);box-shadow:0 4px 22px rgba(0,229,255,0.1);border-left-color:var(--cyan); }

/* PROFILE */
#profileModal { position:fixed;inset:0;background:rgba(0,0,0,0);backdrop-filter:blur(0px);display:none;justify-content:center;align-items:center;z-index:10001;transition:background 0.3s,backdrop-filter 0.3s; }
#profileModal.open { background:rgba(0,0,0,0.65);backdrop-filter:blur(14px); }
.profile-inner { width:500px;max-width:92%;background:rgba(12,12,24,0.97);border-radius:22px;display:flex;overflow:hidden;border:1px solid rgba(0,229,255,0.15);box-shadow:0 0 60px rgba(0,229,255,0.12),0 20px 60px rgba(0,0,0,0.6);position:relative;animation:modalSlideUp 0.4s cubic-bezier(0.34,1.56,0.64,1) both; }
#closeProfile { position:absolute;top:12px;right:14px;font-size:20px;cursor:pointer;color:var(--muted);z-index:10;transition:color 0.2s,transform 0.2s;width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:50%; }
#closeProfile:hover { color:white;transform:rotate(90deg);background:rgba(255,255,255,0.1); }
.profile-img-side { width:44%;position:relative;background:#0a0a14;overflow:hidden; }
.profile-img-side img { width:100%;height:100%;object-fit:cover;display:block;cursor:zoom-in;transition:transform 0.4s; }
.profile-img-side:hover img { transform:scale(1.06); }
.profile-emoji-overlay { position:absolute;top:50%;left:50%;font-size:72px;display:none;animation:emojiPop 0.5s ease both;pointer-events:none;z-index:5; }
.profile-info-side { width:56%;padding:24px;display:flex;flex-direction:column;justify-content:center;gap:12px; }
.profile-info-side h2 { font-family:'Baloo 2',cursive;font-size:20px;color:white; }
.profile-info-side p  { font-size:14px;color:var(--muted); }
.profile-badge { padding:10px 14px;background:rgba(0,229,255,0.07);border:1px solid rgba(0,229,255,0.15);border-radius:10px;font-size:13px;color:var(--text); }
#pMood { margin-top:4px;text-align:center; }

/* ZOOM -- Enhanced like memories modal */
#zoomModal {
  position:fixed; inset:0;
  background:rgba(0,0,0,0.96);
  backdrop-filter:blur(50px); -webkit-backdrop-filter:blur(50px);
  display:none;
  justify-content:center; align-items:center;
  z-index:10002;
  padding:20px;
  opacity:0;
  transition:opacity 0.5s ease;
}
#zoomModal.active {
  display:flex;
  opacity:1;
}
#zoomModal .zoom-content {
  position:relative;
  max-width:95%;
  max-height:90vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  transform:scale(0.75) translateY(20px);
  transition:transform 0.5s cubic-bezier(0.34,1.56,0.64,1), opacity 0.4s ease;
  opacity:0;
}
#zoomModal.active .zoom-content {
  transform:scale(1) translateY(0);
  opacity:1;
}
#zoomModal .zoom-content img {
  max-width:100%;
  max-height:85vh;
  border-radius:35px;
  box-shadow:0 50px 180px rgba(0,0,0,0.98);
  border:1px solid rgba(255,255,255,0.15);
  object-fit:contain;
  background:#000;
}
.zoom-close-btn {
  position:fixed; top:25px; right:25px;
  background:rgba(255,255,255,0.12);
  border:1px solid rgba(255,255,255,0.2);
  color:white;
  width:56px; height:56px;
  border-radius:50%;
  display:flex;
  align-items:center; justify-content:center;
  cursor:pointer;
  font-size:28px;
  z-index:100010;
  transition:all 0.4s cubic-bezier(0.34,1.56,0.64,1);
  backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
  box-shadow:0 8px 32px rgba(0,0,0,0.4);
  line-height:1;
  font-family:Quicksand,sans-serif;
}
.zoom-close-btn:hover {
  background:#ff0055;
  transform:rotate(180deg) scale(1.15);
  box-shadow:0 0 40px rgba(255,0,85,0.8);
  border-color:transparent;
}
.zoom-close-btn:active {
  transform:rotate(180deg) scale(0.95);
}

/* ZOOM LOADING SPINNER */
.zoom-spinner {
  position:absolute; top:50%; left:50%;
  width:60px; height:60px;
  margin:-30px 0 0 -30px;
  border:4px solid rgba(255,255,255,0.1);
  border-top-color:var(--cyan);
  border-radius:50%;
  animation:zoomSpin 0.8s linear infinite;
  z-index:1;
  display:none;
}
.zoom-spinner.visible {
  display:block;
}
#zoomModal .zoom-content img.loading {
  opacity:0;
}
#zoomModal .zoom-content img.loaded {
  opacity:1;
}
@keyframes zoomSpin {
  to { transform:rotate(360deg); }
}

/* POLL BUTTON */
#pollBtn { position:fixed;bottom:24px;right:24px;z-index:8000;padding:16px 34px;border:none;border-radius:999px;cursor:pointer;font-family:'Baloo 2',cursive;font-size:22px;font-weight:800;letter-spacing:.5px;color:white;background:linear-gradient(270deg,#ff6b6b,#ffd700,#4ade80,#00e5ff,#a78bfa,#ff6b6b);background-size:400%;animation:rainbowMove 6s linear infinite,float 2.4s ease-in-out infinite;box-shadow:0 0 24px rgba(255,215,0,.35),0 0 48px rgba(0,229,255,.2),0 10px 30px rgba(0,0,0,.35);transition:transform .2s,box-shadow .2s; }
#pollBtn:hover { transform:scale(1.1);box-shadow:0 0 36px rgba(255,215,0,.6),0 0 64px rgba(0,229,255,.4),0 12px 36px rgba(0,0,0,.4); }

/* POLL MODAL */
#pollModal { position:fixed;inset:0;z-index:9500;background:rgba(0,0,0,0);backdrop-filter:blur(0px);display:none;justify-content:center;align-items:center;transition:background 0.3s,backdrop-filter 0.3s; }
#pollModal.open { background:rgba(0,0,0,0.72);backdrop-filter:blur(14px); }
.poll-inner { width:640px;max-width:95%;max-height:88vh;overflow-y:auto;background:rgba(10,10,22,0.98);border-radius:24px;padding:28px 32px;border:1px solid rgba(0,229,255,0.13);box-shadow:0 0 60px rgba(0,229,255,0.1),0 20px 60px rgba(0,0,0,0.5);position:relative;animation:modalSlideUp 0.4s cubic-bezier(0.34,1.56,0.64,1) both; }
.poll-inner::-webkit-scrollbar { width:4px; }
.poll-inner::-webkit-scrollbar-thumb { background:rgba(0,229,255,0.2);border-radius:4px; }
.poll-title { font-family:'Baloo 2',cursive;text-align:center;color:var(--gold);font-size:22px;margin-bottom:4px; }
.poll-sub { text-align:center;font-size:13px;color:var(--muted);margin-bottom:8px; }
#pollTimer { text-align:center;font-size:13px;color:var(--orange);font-weight:600;margin-bottom:18px; }
#closePoll { position:absolute;top:14px;right:16px;font-size:22px;cursor:pointer;color:var(--muted);transition:color 0.2s,transform 0.2s;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:50%; }
#closePoll:hover { color:white;transform:rotate(90deg);background:rgba(255,255,255,0.08); }
.poll-q { font-size:16px;font-weight:700;text-align:center;margin-bottom:16px; }
.poll-option { margin-bottom:11px; }
.poll-option-label { display:flex;justify-content:space-between;margin-bottom:5px;font-size:13px;align-items:center; }
.poll-bar-track { height:34px;background:rgba(255,255,255,0.06);border-radius:10px;overflow:hidden;position:relative;cursor:pointer;border:1px solid transparent;transition:border-color 0.2s,transform 0.15s; }
.poll-bar-track:hover { border-color:rgba(255,255,255,0.2);transform:scaleY(1.04); }
.poll-bar-track.voted { border-color:var(--cyan);cursor:default; }
.poll-bar-track.voted:hover { transform:none; }
.poll-bar-fill { height:100%;border-radius:10px;min-width:6px;width:0;transition:width 0.9s cubic-bezier(0.22,1,0.36,1);background:linear-gradient(90deg,rgba(0,120,255,0.5),rgba(0,229,255,0.3));box-shadow:0 0 10px rgba(0,140,255,0.2); }
.poll-bar-fill.my-vote { background:linear-gradient(90deg,rgba(255,215,0,0.55),rgba(255,107,0,0.4));box-shadow:0 0 14px rgba(255,200,0,0.35); }
.poll-bar-label { position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:12px;color:rgba(255,255,255,0.45);pointer-events:none; }
.poll-total { text-align:right;font-size:12px;color:var(--muted);margin-top:10px; }
.ripple-effect { position:absolute;border-radius:50%;width:10px;height:10px;margin:-5px 0 0 -5px;background:rgba(255,255,255,0.35);animation:ripple 0.6s ease-out forwards;pointer-events:none;z-index:10; }

/* SLIDESHOW */
.slideshow-wrap { margin: 32px auto; width: 92%; max-width: 800px; border-radius: 20px; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 12px 50px rgba(0,0,0,0.5); background: #0a0a14; }
.slideshow-container { position: relative; width: 100%; aspect-ratio: 16/9; overflow: hidden; border-radius: 20px; }
.slideshow-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.2s cubic-bezier(0.4,0,0.2,1); will-change: opacity; }
.slideshow-slide.active { opacity: 1; }
.slideshow-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
.slideshow-slide::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 50%); pointer-events: none; }
.slideshow-dots { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; z-index: 10; }
.slideshow-dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.3); cursor: pointer; transition: all 0.3s ease; border: none; padding: 0; }
.slideshow-dot.active { background: var(--cyan); box-shadow: 0 0 10px rgba(0,229,255,0.6); transform: scale(1.25); }
.slideshow-dot:hover { background: rgba(255,255,255,0.6); }
.slideshow-label { position: absolute; top: 16px; left: 50%; transform: translateX(-50%); z-index: 10; font-family: 'Baloo 2',cursive; font-size: 15px; font-weight: 700; color: white; text-shadow: 0 2px 12px rgba(0,0,0,0.8); background: rgba(0,0,0,0.4); backdrop-filter: blur(8px); padding: 6px 20px; border-radius: 20px; white-space: nowrap; pointer-events: none; }
.slideshow-nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; background: rgba(0,0,0,0.4); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.1); color: white; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; font-size: 18px; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; opacity: 0; }
.slideshow-wrap:hover .slideshow-nav { opacity: 1; }
.slideshow-nav:hover { background: rgba(0,229,255,0.3); border-color: var(--cyan); transform: translateY(-50%) scale(1.1); }
.slideshow-nav.prev { left: 12px; }
.slideshow-nav.next { right: 12px; }
@media (max-width: 600px) {
  .slideshow-label { font-size: 12px; padding: 4px 14px; top: 10px; }
  .slideshow-nav { width: 32px; height: 32px; font-size: 14px; }
  .slideshow-dot { width: 8px; height: 8px; }
}

/* BIRTHDAY BANNER */
.birthday-overlay { position: fixed; inset: 0; z-index: 50000; display: none; justify-content: center; align-items: flex-start; padding: 100px 16px 0; pointer-events: none; }
.birthday-overlay.active { display: flex; }
.birthday-banner { background: rgba(13,13,24,0.94); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(255,215,0,0.3); border-radius: 24px; padding: 32px 36px; text-align: center; max-width: 420px; width: 100%; box-shadow: 0 0 60px rgba(255,215,0,0.12), 0 20px 60px rgba(0,0,0,0.6); animation: birthdayPop 0.6s cubic-bezier(0.34,1.56,0.64,1) both; pointer-events: all; position: relative; overflow: hidden; }
.birthday-banner::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,215,0,0.06), rgba(255,107,0,0.03)); pointer-events: none; }
@keyframes birthdayPop { 0%{opacity:0;transform:scale(0.45) rotate(-10deg)} 100%{opacity:1;transform:scale(1) rotate(0)} }
.birthday-close { position: absolute; top: 10px; right: 14px; font-size: 20px; cursor: pointer; color: var(--muted); transition: color 0.2s,transform 0.2s; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: none; border: none; font-family: inherit; z-index: 5; }
.birthday-close:hover { color: white; transform: rotate(90deg); background: rgba(255,255,255,0.1); }
.birthday-emoji { font-size: 72px; display: block; margin-bottom: 6px; animation: float 2.5s ease-in-out infinite; }
.birthday-name { font-family: 'Baloo 2',cursive; font-size: 26px; color: var(--gold); font-weight: 800; cursor: pointer; transition: all 0.3s ease; }
.birthday-name:hover { color: #fff; text-shadow: 0 0 20px rgba(255,215,0,0.6); transform: scale(1.05); }
.birthday-age { font-size: 15px; color: var(--muted); margin: 4px 0 2px; }
.birthday-msg { font-size: 15px; color: var(--text); margin-top: 10px; line-height: 1.6; opacity: 0.9; }

/* CONFETTI */
.confetti-piece { position: fixed; top: -20px; z-index: 50001; pointer-events: none; animation: confettiFall var(--fall-dur,3s) linear forwards; opacity: 0; }
@keyframes confettiFall {
  0% { transform: translateY(0) rotate(0deg) scale(1); opacity: 1; }
  100% { transform: translateY(105vh) rotate(var(--rot,720deg)) scale(0.4); opacity: 0; }
}

/* BACK TO TOP — BOTTOM LEFT + FLYING */
.back-to-top {
  position:fixed; bottom:24px; left:24px; right:auto; z-index:30000;
  width:56px; height:56px; border-radius:50%; border:none;
  background:linear-gradient(135deg,#6366f1,#a855f7);
  color:white; font-size:26px; cursor:pointer;
  box-shadow:0 4px 20px rgba(99,102,241,0.4);
  transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1);
  display:flex; align-items:center; justify-content:center;
  opacity:0; visibility:hidden; transform:translateY(20px) scale(0.85);
  font-family:'Quicksand',sans-serif;
}
.back-to-top::before {
  content:''; position:absolute; inset:-5px;
  background:linear-gradient(270deg,#ff6b6b,#ffd700,#4ade80,#00e5ff,#a78bfa);
  background-size:400%; z-index:-1; border-radius:50%;
  filter:blur(15px); opacity:0; animation:rainbowMove 6s linear infinite;
  transition:opacity 0.5s ease;
}
.back-to-top.visible { opacity:1; visibility:visible; animation:floatyBackToTop 3s ease-in-out infinite; }
.back-to-top.visible::before { opacity:0.35; }
@keyframes floatyBackToTop {
  0%,100% { transform:translateY(0) scale(1); }
  50% { transform:translateY(-8px) scale(1); }
}
.back-to-top:hover { animation-play-state:paused; transform:translateY(-5px) scale(1.15); box-shadow:0 8px 35px rgba(99,102,241,0.8); }
.back-to-top:hover::before { opacity:0.6; }
.back-to-top:active { transform:scale(0.92) !important; animation:none !important; }
@media(max-width:768px){
  .back-to-top { bottom:16px; left:16px; width:50px; height:50px; font-size:22px; }
}

/* ========== NEW UI/UX IMPROVEMENTS ========== */

/* HAMBURGER MENU */
.hamburger-btn {
  display:none; flex-direction:column; justify-content:center;
  align-items:center; gap:5px; width:40px; height:40px;
  background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1);
  border-radius:12px; cursor:pointer; position:relative;
  transition:all 0.3s ease; z-index:1001; padding:8px;
}
.hamburger-btn:hover { background:rgba(0,229,255,0.1); border-color:var(--cyan); }
.hamburger-btn span {
  display:block; width:100%; height:2.5px; background:white; border-radius:4px;
  transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1); transform-origin:center;
}
.hamburger-btn.active span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
.hamburger-btn.active span:nth-child(2) { opacity:0; transform:scaleX(0); }
.hamburger-btn.active span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }

/* MOBILE OVERLAY MENU */
.mobile-overlay {
  position:fixed; inset:0; z-index:999; background:rgba(8,8,18,0.92);
  backdrop-filter:blur(30px); -webkit-backdrop-filter:blur(30px);
  display:none; flex-direction:column; justify-content:center; align-items:center;
  gap:12px; opacity:0; transition:opacity 0.4s ease;
}
.mobile-overlay.active { display:flex; opacity:1; }
.mobile-overlay a {
  font-family:'Baloo 2',cursive; font-size:28px; font-weight:700;
  color:white; text-decoration:none; padding:12px 28px;
  border-radius:16px; transition:all 0.3s ease;
  position:relative; overflow:hidden;
}
.mobile-overlay a::before {
  content:''; position:absolute; inset:0; background:linear-gradient(135deg,rgba(0,229,255,0.08),rgba(160,60,255,0.04));
  border-radius:16px; opacity:0; transition:opacity 0.3s;
}
.mobile-overlay a:hover::before { opacity:1; }
.mobile-overlay a:hover { transform:scale(1.06); color:var(--cyan); }
.mobile-overlay a:active { transform:scale(0.95); }

/* BOTTOM NAV — MOBILE */
.bottom-nav {
  display:none; position:fixed; bottom:0; left:0; right:0;
  z-index:99999; background:rgba(8,8,18,0.88); backdrop-filter:blur(24px);
  -webkit-backdrop-filter:blur(24px); border-top:1px solid rgba(255,255,255,0.06);
  padding:6px 0 env(safe-area-inset-bottom,6px);
  justify-content:space-around; align-items:center;
}
.bottom-nav a {
  display:flex; flex-direction:column; align-items:center; gap:2px;
  text-decoration:none; color:var(--muted); font-size:10px; font-weight:600;
  padding:6px 12px; border-radius:12px; transition:all 0.25s ease;
  position:relative;
}
.bottom-nav a .nav-icon { font-size:20px; transition:transform 0.3s; }
.bottom-nav a.active { color:var(--cyan); }
.bottom-nav a.active .nav-icon { transform:scale(1.15); }
.bottom-nav a.active::after {
  content:''; position:absolute; top:-1px; left:35%; right:35%; height:2px;
  background:var(--cyan); border-radius:4px; box-shadow:0 0 10px rgba(0,229,255,0.5);
}
.bottom-nav a:active { transform:scale(0.9); }

/* ENHANCED TIMELINE */
.timeline-enhanced { position:relative; max-width:600px; margin:0 auto; padding:16px 0; }
.timeline-enhanced::before {
  content:''; position:absolute; left:28px; top:0; bottom:0;
  width:2px; background:linear-gradient(to bottom,transparent,var(--cyan),var(--gold),var(--cyan),transparent);
  opacity:0.3; border-radius:4px;
}
.tl-enhanced-item {
  position:relative; padding:12px 12px 12px 64px; margin-bottom:14px;
  animation:fadeUp 0.6s ease both;
}
.tl-enhanced-dot {
  position:absolute; left:20px; top:18px; width:18px; height:18px;
  border-radius:50%; background:linear-gradient(135deg,var(--cyan),#a78bfa);
  border:3px solid rgba(8,8,18,0.95); box-shadow:0 0 16px rgba(0,229,255,0.25);
  z-index:2; transition:transform 0.3s,box-shadow 0.3s;
}
.tl-enhanced-item:hover .tl-enhanced-dot {
  transform:scale(1.3); box-shadow:0 0 28px rgba(0,229,255,0.5);
}
.tl-enhanced-card {
  background:var(--card); backdrop-filter:blur(8px);
  border:1px solid var(--border); border-radius:16px; padding:16px 18px;
  transition:all 0.3s cubic-bezier(0.34,1.56,0.64,1); cursor:pointer;
}
.tl-enhanced-card:hover {
  transform:translateX(8px) scale(1.02);
  box-shadow:0 8px 30px rgba(0,229,255,0.12);
  border-color:rgba(0,229,255,0.25);
}
.tl-enhanced-icon { font-size:18px; margin-right:6px; }
.tl-enhanced-text { font-size:14px; color:var(--text); line-height:1.5; }
.tl-enhanced-date {
  display:block; font-size:11px; color:var(--cyan); font-weight:600;
  margin-bottom:4px; letter-spacing:0.3px;
}

/* LEADERBOARD BARS */
.leader-visual { display:flex; flex-direction:column; gap:8px; }
.lv-row {
  display:flex; align-items:center; gap:10px;
  padding:4px 0; animation:slideLeft 0.5s ease both;
}
.lv-medal { width:28px; text-align:center; font-size:16px; flex-shrink:0; }
.lv-name { flex-shrink:0; font-size:13px; font-weight:600; width:130px; min-width:80px; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.lv-bar-track {
  flex:1; height:18px; background:rgba(255,255,255,0.05);
  border-radius:99px; overflow:hidden; position:relative;
}
.lv-bar-fill {
  height:100%; border-radius:99px; width:0%;
  transition:width 1.2s cubic-bezier(0.22,1,0.36,1);
  position:relative;
}
.lv-bar-fill.gold   { background:linear-gradient(90deg,#FFD700,#FFB800); box-shadow:0 0 12px rgba(255,215,0,0.3); }
.lv-bar-fill.silver { background:linear-gradient(90deg,#E5E7EB,#BFC5CE); box-shadow:0 0 8px rgba(200,200,200,0.2); }
.lv-bar-fill.bronze { background:linear-gradient(90deg,#CD7F32,#A85A1F); box-shadow:0 0 8px rgba(205,127,50,0.3); }
.lv-bar-fill.regular { background:linear-gradient(90deg,rgba(0,229,255,0.3),rgba(0,229,255,0.15)); }
.lv-pct { font-size:11px; color:var(--muted); width:36px; text-align:right; flex-shrink:0; font-weight:600; }

/* CURSOR GLOW */
.cursor-glow {
  position:fixed; pointer-events:none; z-index:999999;
  width:300px; height:300px; border-radius:50%;
  background:radial-gradient(circle,rgba(0,229,255,0.06) 0%,transparent 70%);
  transform:translate(-50%,-50%); transition:opacity 0.3s;
  opacity:0; will-change:transform;
}
.cursor-glow.visible { opacity:1; }

/* SECTION DIVIDERS */
.section-divider {
  width:80%; max-width:300px; height:1px; margin:0 auto;
  background:linear-gradient(90deg,transparent,rgba(0,229,255,0.15),rgba(168,85,247,0.15),transparent);
  position:relative;
}
.section-divider::after {
  content:'✦'; position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
  color:var(--cyan); font-size:10px; background:var(--bg); padding:0 12px;
}

/* ENHANCED CARD EFFECTS */
.member-card {
  transition:transform 0.4s cubic-bezier(0.34,1.56,0.64,1),box-shadow 0.4s,border-color 0.3s;
}
.member-card::after {
  content:''; position:absolute; inset:0; border-radius:14px;
  background:linear-gradient(135deg,rgba(0,229,255,0.1),transparent);
  opacity:0; transition:opacity 0.4s; pointer-events:none;
}
.member-card:hover::after { opacity:1; }
.member-card:hover {
  transform:translateY(-10px) scale(1.05) !important;
  box-shadow:0 20px 50px rgba(0,229,255,0.25) !important;
  border-color:rgba(0,229,255,0.35) !important;
}

/* NAVBAR ACTIVE LINK */
.navbar-menu a.active-link {
  color:var(--cyan) !important;
}
.navbar-menu a.active-link::after {
  left:14px !important; right:14px !important;
  background:var(--cyan); box-shadow:0 0 12px rgba(0,229,255,0.5);
}

/* ENHANCED REVEAL */
/* SLIDESHOW SWIPE HINT */
.swipe-hint {
  position:absolute; bottom:50%; right:20px; z-index:10;
  display:flex; align-items:center; gap:4px;
  color:rgba(255,255,255,0.5); font-size:11px; font-weight:600;
  opacity:0; animation:swipeHintAnim 3s ease-in-out 2s forwards;
  pointer-events:none;
}
@keyframes swipeHintAnim {
  0%,100%{opacity:0;transform:translateX(0)}
  10%{opacity:1;transform:translateX(0)}
  35%{opacity:0;transform:translateX(20px)}
  50%{opacity:0;transform:translateX(0)}
}

/* LOADING SKELETON */
@keyframes shimmer {
  0%{background-position:-200% 0}
  100%{background-position:200% 0}
}
.skeleton {
  background:linear-gradient(90deg,rgba(255,255,255,0.04) 25%,rgba(255,255,255,0.08) 50%,rgba(255,255,255,0.04) 75%);
  background-size:200% 100%; animation:shimmer 1.5s ease infinite;
  border-radius:12px;
}

/* MEMBER CATEGORY FILTER */
.filter-chips {
  display:flex; flex-wrap:wrap; justify-content:center; gap:8px;
  margin:12px auto 16px; max-width:500px;
}
.filter-chip {
  padding:6px 16px; border-radius:20px; font-size:12px; font-weight:600;
  font-family:'Quicksand',sans-serif;
  background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08);
  color:var(--muted); cursor:pointer; transition:all 0.25s ease;
  user-select:none;
}
.filter-chip:hover { background:rgba(0,229,255,0.1); border-color:var(--cyan); color:white; transform:translateY(-2px); }
.filter-chip.active { background:linear-gradient(135deg,rgba(0,229,255,0.2),rgba(99,102,241,0.2)); border-color:var(--cyan); color:var(--cyan); }
.filter-chip:active { transform:scale(0.92); }

/* CATEGORY BADGE ON CARDS */
.cat-badge {
  position:absolute; bottom:8px; right:8px; z-index:6;
  padding:3px 8px; border-radius:8px; font-size:9px; font-weight:700;
  background:rgba(8,8,18,0.7); backdrop-filter:blur(6px);
  color:var(--muted); border:1px solid rgba(255,255,255,0.06);
  pointer-events:none; opacity:0; transition:opacity 0.3s;
}
.member-card:hover .cat-badge { opacity:1; }

/* RESPONSIVE */
@media(max-width:768px){
  .hamburger-btn { display:flex; }
  .navbar-menu { display:none; }
  .navbar-center { display:none; }
  .bottom-nav { display:flex; }
  .navbar { padding:10px 16px; }
  section { padding-top:80px; padding-bottom:70px; }
  .back-to-top { bottom:16px; left:16px; width:44px; height:44px; font-size:20px; }
}
@media(max-width:480px){
  .timeline-enhanced::before { left:20px; }
  .tl-enhanced-item { padding-left:52px; }
  .tl-enhanced-dot { left:14px; width:14px; height:14px; }
  .lv-name { width:100px; font-size:12px; }
  .members-grid { grid-template-columns:repeat(auto-fill,minmax(130px,1fr)); gap:10px; padding:10px; }
}
@media(min-width:769px){
  .mobile-overlay { display:none !important; }
}

/* PROGRESS BAR LOAD ANIMATION */
@keyframes barGlow {
  0% { filter:brightness(1); }
  50% { filter:brightness(1.4); }
  100% { filter:brightness(1); }
}
.prog-fill.loading {
  animation: barGlow 1.2s ease-out 0.3s;
}

/* COUNTDOWN POP ANIMATION */
@keyframes countPop {
  0% { transform:scale(1); }
  30% { transform:scale(1.25); }
  60% { transform:scale(0.92); }
  100% { transform:scale(1); }
}
.cd-count.pop {
  animation:countPop 0.45s cubic-bezier(0.34,1.56,0.64,1) both;
}

/* DIGIT POP ANIMATION for h/m/s */
@keyframes digitPop {
  0% { transform:scale(1); }
  30% { transform:scale(1.3); color:var(--cyan); }
  60% { transform:scale(0.92); }
  100% { transform:scale(1); }
}
.cd-digit {
  display:inline-block;
  transition:color 0.3s;
}
.cd-digit.pop {
  animation:digitPop 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
}

/* SCROLL PROGRESS BAR */
.scroll-progress {
  position:fixed; top:0; left:0; width:0%; height:3px;
  background:linear-gradient(90deg,var(--cyan),var(--gold),#a78bfa,var(--cyan));
  background-size:300%; animation:rainbowMove 3s linear infinite;
  z-index:10001; transition:width 0.08s linear;
  box-shadow:0 0 12px rgba(0,229,255,0.4),0 0 24px rgba(255,215,0,0.2);
}

/* SCROLL REVEAL */
.reveal { opacity:0;transform:translateY(32px);transition:opacity 0.7s ease,transform 0.7s cubic-bezier(0.34,1.56,0.64,1); }
.reveal.visible { opacity:1;transform:translateY(0); }

/* ENHANCED PARTICLE LOADING */
@keyframes particleFloat {
  0%{transform:translateY(0) rotate(0deg) scale(0);opacity:0}
  20%{opacity:0.6}
  80%{opacity:0.3}
  100%{transform:translateY(-100vh) rotate(720deg) scale(1);opacity:0}
}
.load-particle {
  position:absolute; width:4px; height:4px; border-radius:50%;
  pointer-events:none; animation:particleFloat var(--dur,4s) linear infinite;
  animation-delay:var(--delay,0s);
}
.load-particle:nth-child(odd) { background:var(--cyan); box-shadow:0 0 6px var(--cyan); }
.load-particle:nth-child(even) { background:var(--gold); box-shadow:0 0 6px var(--gold); }

/* CARD 3D TILT */
.member-card.tilt-active {
  transition:transform 0.05s ease !important;
}

/* LEADERBOARD BAR LOAD ANIMATION */
.lv-bar-fill {
  transition:width 1.5s cubic-bezier(0.22,1,0.36,1) !important;
}

/* ENHANCED SECTION DIVIDERS */
.section-divider-glow {
  width:60%; max-width:200px; height:3px; margin:0 auto;
  background:linear-gradient(90deg,transparent,rgba(0,229,255,0.4),rgba(168,85,247,0.4),transparent);
  border-radius:4px; filter:blur(8px);
}

/* PARALLAX LAYER */
.parallax-layer {
  position:fixed; inset:0; z-index:-3;
  background:url('Lop.jpg') center/cover no-repeat;
  filter:blur(8px) brightness(0.25) saturate(0.5);
}

/* COUNTDOWN REFINEMENTS */
.cd-top { perspective:500px; }
.cd-count { transform-style:preserve-3d; }

/* SMOOTH NAVIGATION INDICATOR */
.scroll-indicator {
  position:absolute; bottom:30px; left:50%; transform:translateX(-50%);
  display:flex; flex-direction:column; align-items:center; gap:8px;
  opacity:0.6; animation:float 2s ease-in-out infinite;
  cursor:pointer; transition:opacity 0.3s;
  z-index:5;
}
.scroll-indicator:hover { opacity:1; }
.scroll-indicator span {
  display:block; width:24px; height:36px;
  border:2px solid rgba(255,255,255,0.4); border-radius:12px;
  position:relative;
}
.scroll-indicator span::after {
  content:''; position:absolute; top:6px; left:50%; transform:translateX(-50%);
  width:3px; height:8px; background:var(--cyan); border-radius:4px;
  animation:scrollWheel 1.6s ease-in-out infinite;
}
@keyframes scrollWheel {
  0%{transform:translateX(-50%) translateY(0);opacity:1}
  100%{transform:translateX(-50%) translateY(12px);opacity:0}
}
.scroll-indicator-text { font-size:11px; color:var(--muted); letter-spacing:2px; }

/* MEMBER GRID STAGGER ANIMATION */
.member-card {
  animation:fadeUp 0.5s ease both;
}

/* BIRTHDAY BANNER ENHANCEMENT */
.birthday-banner {
  position:relative; overflow:hidden;
}
.birthday-banner::after {
  content:'🎉'; position:absolute; font-size:120px; opacity:0.04;
  top:-20px; right:-20px; pointer-events:none;
  animation:float 4s ease-in-out infinite;
}

/* POLL BUTTON ENHANCED */
#pollBtn {
  position:fixed;bottom:24px;right:24px;z-index:8000;padding:16px 34px;border:none;border-radius:999px;cursor:pointer;font-family:'Baloo 2',cursive;font-size:22px;font-weight:800;letter-spacing:.5px;color:white;background:linear-gradient(270deg,#ff6b6b,#ffd700,#4ade80,#00e5ff,#a78bfa,#ff6b6b);background-size:400%;animation:rainbowMove 6s linear infinite,float 2.4s ease-in-out infinite;box-shadow:0 0 24px rgba(255,215,0,.35),0 0 48px rgba(0,229,255,.2),0 10px 30px rgba(0,0,0,.35);transition:transform .2s,box-shadow .2s; }
#pollBtn:hover { transform:scale(1.1);box-shadow:0 0 36px rgba(255,215,0,.6),0 0 64px rgba(0,229,255,.4),0 12px 36px rgba(0,0,0,.4); }
#pollBtn::after {
  content:''; position:absolute; inset:-3px; border-radius:999px;
  background:linear-gradient(270deg,#ff6b6b,#ffd700,#4ade80,#00e5ff,#a78bfa);
  background-size:400%; z-index:-1; filter:blur(18px); opacity:0.3;
  animation:rainbowMove 6s linear infinite;
  transition:opacity 0.3s;
}
#pollBtn:hover::after { opacity:0.6; }

/* ========== 🆕 NEW MODERN FEATURES ========== */

/* CUSTOM SCROLLBAR */
::-webkit-scrollbar { width:8px; }
::-webkit-scrollbar-track { background:var(--bg); }
::-webkit-scrollbar-thumb { background:linear-gradient(180deg,var(--cyan),#a78bfa); border-radius:99px; border:2px solid var(--bg); }
::-webkit-scrollbar-thumb:hover { background:linear-gradient(180deg,#00f5ff,#b97cff); }

/* PARTICLE NETWORK CANVAS */
#particleCanvas {
  position:fixed; inset:0; z-index:-1;
  pointer-events:none;
  opacity:0.5;
}

/* SPLIT TEXT ANIMATION */
.split-char {
  display:inline-block;
  opacity:0; transform:translateY(20px) rotateX(40deg);
  transition:opacity 0.4s cubic-bezier(0.34,1.56,0.64,1), transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
}
.split-char.visible {
  opacity:1; transform:translateY(0) rotateX(0);
}
.split-word {
  display:inline-block;
  white-space:nowrap;
}

/* MAGNETIC BUTTONS */
.magnetic {
  transition:transform 0.2s cubic-bezier(0.34,1.56,0.64,1) !important;
}

/* WAVE DIVIDER */
.wave-divider {
  position:relative; width:100%; height:60px; overflow:hidden;
  margin:-1px 0; line-height:0;
}
.wave-divider svg {
  position:absolute; bottom:0; left:0; width:100%; height:100%;
}

/* FLOATING EMOJIS */
.floating-emoji {
  position:fixed; pointer-events:none; z-index:0;
  font-size:var(--emoji-size,24px);
  animation:emojiFloat var(--dur,12s) ease-in-out infinite;
  animation-delay:var(--delay,0s);
  opacity:0.08;
}
@keyframes emojiFloat {
  0% { transform:translateY(100vh) rotate(0deg) scale(0); opacity:0; }
  10% { opacity:0.12; }
  50% { opacity:0.06; }
  90% { opacity:0.12; }
  100% { transform:translateY(-10vh) rotate(360deg) scale(1); opacity:0; }
}

/* RIPPLE CONTAINER */
.ripple-btn {
  position:relative; overflow:hidden !important;
}
.ripple-effect-btn {
  position:absolute; border-radius:50%;
  width:20px; height:20px; margin:-10px 0 0 -10px;
  background:rgba(255,255,255,0.3);
  animation:rippleBtn 0.6s ease-out forwards;
  pointer-events:none; z-index:10;
}
@keyframes rippleBtn {
  0% { transform:scale(0); opacity:0.5; }
  100% { transform:scale(6); opacity:0; }
}

/* GRADIENT BORDER ANIMATION */
.gradient-border {
  position:relative;
}
.gradient-border::before {
  content:''; position:absolute; inset:-2px; border-radius:inherit;
  background:linear-gradient(135deg,var(--cyan),var(--gold),#a78bfa,var(--cyan));
  background-size:400%; z-index:-1;
  animation:borderRotate 4s linear infinite;
  opacity:0; transition:opacity 0.3s;
}
.gradient-border:hover::before {
  opacity:1;
}
@keyframes borderRotate {
  0% { background-position:0% 50%; }
  100% { background-position:400% 50%; }
}

/* GLASS CARD ENHANCED */
.glass-card {
  background:linear-gradient(135deg,rgba(255,255,255,0.05),rgba(255,255,255,0.01)) !important;
  backdrop-filter:blur(16px) !important;
  border:1px solid rgba(255,255,255,0.08) !important;
}

/* COUNTER ANIMATION */
@keyframes counterPop {
  0% { transform:scale(1); }
  30% { transform:scale(1.2); color:var(--gold); }
  100% { transform:scale(1); }
}
.counter-value.pop {
  animation:counterPop 0.4s ease;
}

/* SECTION TRANSITIONS */
.section-enter {
  animation:sectionEnter 1s cubic-bezier(0.34,1.56,0.64,1) both;
}
@keyframes sectionEnter {
  0% { opacity:0; transform:translateY(40px) scale(0.96); filter:blur(4px); }
  100% { opacity:1; transform:translateY(0) scale(1); filter:blur(0); }
}

/* GLOW TEXT EFFECT */
.glow-text {
  text-shadow:0 0 20px rgba(0,229,255,0.15),0 0 40px rgba(0,229,255,0.05);
}

/* MEMORY STATS */
.memory-stats {
  display:flex; justify-content:center; gap:24px; flex-wrap:wrap;
  margin:20px auto; max-width:500px;
}
.memory-stat {
  display:flex; flex-direction:column; align-items:center;
  padding:12px 20px; background:var(--card);
  backdrop-filter:blur(8px); border:1px solid var(--border);
  border-radius:16px; min-width:80px;
  transition:transform 0.3s,box-shadow 0.3s;
}
.memory-stat:hover {
  transform:translateY(-4px);
  box-shadow:0 8px 25px rgba(0,229,255,0.1);
}
.stat-number {
  font-family:'Baloo 2',cursive; font-size:28px; font-weight:800;
  background:linear-gradient(90deg,var(--gold),var(--orange));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.stat-label {
  font-size:11px; color:var(--muted); font-weight:600;
  letter-spacing:0.5px; margin-top:2px;
}

/* RESPONSIVE ADDITIONS */
@media(max-width:768px){
  .memory-stats { gap:12px; }
  .memory-stat { min-width:70px; padding:10px 14px; }
  .stat-number { font-size:22px; }
  .wave-divider { height:35px; }
}
</head>
<body>

<!-- BIRTHDAY BANNER -->
<div class="birthday-overlay" id="birthdayOverlay">
  <div class="birthday-banner" id="birthdayBanner">
    <button class="birthday-close" id="birthdayClose">✖</button>
    <span class="birthday-emoji" id="birthdayEmoji">🎂</span>
    <div class="birthday-name" id="birthdayName"></div>
    <div class="birthday-age" id="birthdayAge"></div>
    <div class="birthday-msg" id="birthdayMsg">🎉 Chúc mừng sinh nhật! Chúc bạn luôn vui vẻ, học giỏi và tỏa sáng nhé! 💫</div>
  </div>
</div>

<!-- LOADING -->
<div id="loadingScreen">
  <div class="load-title">A1 — THCS CVA - TT 🎓</div>
  <div class="load-bar-wrap"><div class="load-bar" id="loadBar"></div></div>
  <div class="load-sub">Loading</div>
  <!-- Loading particles -->
  <div class="load-particle" style="left:15%;--dur:3.2s;--delay:0s"></div>
  <div class="load-particle" style="left:35%;--dur:4.1s;--delay:0.3s"></div>
  <div class="load-particle" style="left:55%;--dur:3.8s;--delay:0.7s"></div>
  <div class="load-particle" style="left:72%;--dur:4.5s;--delay:1.1s"></div>
  <div class="load-particle" style="left:88%;--dur:3.5s;--delay:0.5s"></div>
  <div class="load-particle" style="left:25%;--dur:4.8s;--delay:1.4s"></div>
  <div class="load-particle" style="left:62%;--dur:3.0s;--delay:0.9s"></div>
  <div class="load-particle" style="left:45%;--dur:5.0s;--delay:0.1s"></div>
  <div class="load-particle" style="left:80%;--dur:4.2s;--delay:1.7s"></div>
  <div class="load-particle" style="left:10%;--dur:3.6s;--delay:2.0s"></div>
</div>

<!-- SCROLL PROGRESS BAR -->
<div class="scroll-progress" id="scrollProgress"></div>

<!-- CURSOR GLOW -->
<div class="cursor-glow" id="cursorGlow"></div>

<!-- NAVBAR -->
<nav class="navbar" id="mainNavbar">
  <div class="navbar-logo">
    <img src="Logolop.jpeg" alt="logo" onclick="location.reload()" style="cursor:pointer;">
    <div class="navbar-title" style="cursor:pointer;" onclick="location.reload()">A1 — THCS CVA - TT (2024–2028)</div>
  </div>
  <div class="navbar-center">
    <img src="PhamThuyAn.jpg" id="creatorAvatar" onerror="this.style.display='none'" class="navbar-avatar" alt="Creator: Thúy An" style="animation-delay:0.3s;cursor:pointer;">
    <div>
      <div class="navbar-made">Made by ChatGPT &amp; Copilot &amp; Claude Code &amp; Gemini CLI &amp; Blackbox AI &amp; FreeBuff Code 😄</div>
      <div class="navbar-creator">Creator & Tester: Thúy An &amp; Dev Khánhh</div>
    </div>
    <img src="LaiVuNamKhanh.jpg" id="testerAvatar" onerror="this.style.display='none'" class="navbar-avatar" alt="Tester: Dev Khánh" style="animation-delay:0.6s;cursor:pointer;">
  </div>
  <nav class="navbar-menu" id="navbarMenu">
    <a href="#memories">Khoảnh khắc</a>
    <a href="#members">Thành viên</a>
    <a href="#timeline">Timeline</a>
  </nav>
  <button class="hamburger-btn" id="hamburgerBtn" aria-label="Menu">
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>

<!-- MOBILE OVERLAY MENU -->
<div class="mobile-overlay" id="mobileOverlay">
  <a href="#memories" data-close-overlay>📸 Khoảnh khắc</a>
  <a href="#members" data-close-overlay>👥 Thành viên</a>
  <a href="#timeline" data-close-overlay>📅 Timeline</a>
</div>

<!-- BOTTOM NAV (MOBILE) -->
<nav class="bottom-nav" id="bottomNav">
  <a href="#memories">
    <span class="nav-icon">📸</span>
    <span>Khoảnh khắc</span>
  </a>
  <a href="#members">
    <span class="nav-icon">👥</span>
    <span>Thành viên</span>
  </a>
  <a href="#timeline">
    <span class="nav-icon">📅</span>
    <span>Timeline</span>
  </a>
</nav>

<!-- HOME -->
<section id="home">
  <h2 class="section-title split-text">🎓 Chào mừng đến lớp 7A1</h2>
  <div class="class-photo-wrap">
<img src="Lop.jpg" id="classPhoto" onerror="this.src='https://via.placeholder.com/1200x600/0d0d14/ffffff?text=7A1+Class+Photo'">   <div class="class-photo-overlay">
      <button class="overlay-btn magnetic" onclick="document.getElementById('members').scrollIntoView({behavior:'smooth'})">👥 Xem thành viên</button>
    </div>
  </div>

  <!-- SCROLL INDICATOR -->
  <div class="scroll-indicator" onclick="document.getElementById('memories').scrollIntoView({behavior:'smooth'})">
    <span></span>
    <div class="scroll-indicator-text">SCROLL</div>
  </div>

  <!-- COUNTDOWN BOX (merged) -->
  <div class="countdown-box reveal" id="countdownBox">
    <!-- Summer -->
    <div class="cd-section cd-summer">
      <div class="cd-label">☀️ ĐẾM NGƯỢC NGHỈ HÈ</div>
      <div class="cd-top">
        <div class="cd-count" id="summerDays">--</div>
        <div class="cd-sub" id="summerSub">ngày nữa thôi!</div>
      </div>
      <div class="prog-row">
        <span class="prog-label" id="summerStart">--/--</span>
        <div class="prog-track"><div class="prog-fill summer-fill loading" id="summerBar" style="width:0%"></div></div>
        <span class="prog-label" id="summerEnd">--/--</span>
      </div>
      <div class="prog-pct" id="summerPct">0%</div>
    </div>

    <div class="cd-divider"><span>✦</span></div>

    <!-- School -->
    <div class="cd-section cd-school">
      <div class="cd-label cd-label-blue">📚 ĐẾM NGƯỢC ĐI HỌC LẠI</div>
      <div class="cd-top">
        <div class="cd-count cd-count-blue" id="schoolDays">--</div>
        <div class="cd-sub cd-sub-blue" id="schoolSub">ngày nữa thôi!</div>
      </div>
      <div class="prog-row">
        <span class="prog-label" id="schoolStart">Hè ( 27/05 )</span>
        <div class="prog-track"><div class="prog-fill school-fill loading" id="schoolBar" style="width:0%"></div></div>
        <span class="prog-label" id="schoolEnd">05/09</span>
      </div>
      <div class="prog-pct prog-pct-blue" id="schoolPct">0%</div>
    </div>
  </div>

  <div class="random-box reveal">
    <h3>🎲 Thành viên ngẫu nhiên</h3>
    <div class="rand-card" id="randCard">
      <img id="randImg" src="" onerror="this.style.display='none'" alt="">
      <div class="rand-info">
        <div class="rand-emoji" id="randEmoji">🎲</div>
        <strong class="rand-name" id="randName">Bấm Random để bắt đầu!</strong>
        <small class="rand-detail" id="randDob"></small>
        <small class="rand-detail" id="randNick"></small>
      </div>
    </div>
    <button class="btn-rainbow magnetic" id="btnRandom">🔀 Random</button>
    <div id="spinStatus"></div>
  </div>

  <div class="leader-box reveal">
    <h2>🏆 Bảng xếp hạng Top 10 — Tuần 29</h2>
    <div class="leader-visual" id="leaderVisual">
      <div class="lv-row" style="animation-delay:0s">
        <span class="lv-medal">🥇</span>
        <span class="lv-name gold">Lê Nguyễn Thùy Dương</span>
        <div class="lv-bar-track"><div class="lv-bar-fill gold" style="width:96%"></div></div>
        <span class="lv-pct">96%</span>
      </div>
      <div class="lv-row" style="animation-delay:0.08s">
        <span class="lv-medal">🥈</span>
        <span class="lv-name silver">Lê Bảo Anh</span>
        <div class="lv-bar-track"><div class="lv-bar-fill silver" style="width:82%"></div></div>
        <span class="lv-pct">82%</span>
      </div>
      <div class="lv-row" style="animation-delay:0.16s">
        <span class="lv-medal">🥉</span>
        <span class="lv-name bronze">Lại Vũ Nam Khánh (Dev)</span>
        <div class="lv-bar-track"><div class="lv-bar-fill bronze" style="width:68%"></div></div>
        <span class="lv-pct">68%</span>
      </div>
      <div class="lv-row" style="animation-delay:0.24s">
        <span class="lv-medal">4</span>
        <span class="lv-name" style="color:var(--text)">Dương Thanh Bình</span>
        <div class="lv-bar-track"><div class="lv-bar-fill regular" style="width:55%"></div></div>
        <span class="lv-pct">55%</span>
      </div>
